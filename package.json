{
  "name": "model-advisor-mcp",
  "version": "1.5.0",
  "description": "MCP server for matching OpenCode models to Gentle AI agent criteria.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlonsoSG0/model-advisor-mcp.git"
  },
  "homepage": "https://github.com/AlonsoSG0/model-advisor-mcp#readme",
  "bugs": {
    "url": "https://github.com/AlonsoSG0/model-advisor-mcp/issues"
  },
  "type": "module",
  "bin": {
    "model-advisor-mcp": "dist/server.js"
  },
  "files": [
    "dist/",
    "guia_gentle_ai.md",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "AtripArch",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opencode",
    "openrouter",
    "ai-models"
  ],
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/server.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:unit && npm run test:handshake",
    "test:unit": "node --test test/*.test.mjs",
    "test:handshake": "bash test/handshake.sh dist/server.js",
    "verify": "npm run typecheck && npm run test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
